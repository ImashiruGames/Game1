import {KIT_ROLES} from '../../src/next/meta/kits.ts';
import {boardSkillName,currentBoardInformation,currentFormInformation} from '../../src/next/ui/kitInformation.ts';
import {normalSkillIds,skillCatalog,skillName,skillDescription,skillValue} from '../../src/next/core/skillCatalog.ts';
